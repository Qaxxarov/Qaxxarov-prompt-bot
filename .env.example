# ═══════════════════════════════════════════════════
# AGRO AI v3.0 — Environment Variables
# ═══════════════════════════════════════════════════

# ── Telegram ──
TELEGRAM_BOT_TOKEN=your_bot_token_here
ALLOWED_USER_IDS=123456789,987654321

# ── Chrome (scraping uchun) ──
CHROME_USER_DATA_DIR=
CHROME_PROFILE_DIR=Default

# ── Instagram ──
TARGET_PROFILE=your_instagram_username

# ── OpenAI ──
OPENAI_API_KEY=your_openai_key
OPENAI_MODEL=gpt-4o-mini

# ── Dashboard ──
DASHBOARD_PASSWORD=
ALLOWED_ORIGINS=http://localhost:8000
WEBAPP_URL=

# ── Scraping ──
MAX_REELS=20
HEADLESS=1
DELAY_MIN=2
DELAY_MAX=5
SCRAPE_TIMEOUT_SEC=300
MAX_SCRAPES_PER_HOUR=5

# ── Export ──
EXPORT_DIR=reports

# ── Proxy (ixtiyoriy) ──
HTTP_PROXY=
HTTPS_PROXY=

# ── Posting (ixtiyoriy, Instagram Graph API) ──
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ID=
